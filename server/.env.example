# 纳米Work行业版 · 本地安全默认模板（复制为 server/.env）

# 运行边界：新项目默认只监听本机 3107，不占用其他项目端口
NODE_ENV=development
HOST=127.0.0.1
PORT=3107

# 可选：指定本项目独立数据库；留空时使用 server/data/nanowork-industry.db
NANOWORK_DB=
# 仅本地演示才可改为 true；生产环境强制禁用
SEED_DEMO=false

# 登录态签名密钥：生产必填，至少 32 字节的强随机串
# 生成示例：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# 平台超级管理员；仅首次初始化无 platform_super 账号时使用
# 生产首次启动密码至少 12 位，且大小写字母、数字、特殊字符至少包含三类
PLATFORM_SUPER_USERNAME=super
PLATFORM_SUPER_PASSWORD=

# 云雾 / Anthropic AI（也可在管理后台配置，企业配置优先）
YUNWU_API_KEY=
YUNWU_BASE_URL=https://yunwu.ai/v1
ANTHROPIC_API_KEY=
AI_MODEL=

# 联网检索（老板参谋「联网」开关）：按顺序尝试 博查 → Tavily → Serper，
# 全部留空时兜底 DuckDuckGo（国内网络通常不可达，正式部署至少配一个）
BOCHA_API_KEY=
TAVILY_API_KEY=
SERPER_API_KEY=

# 飞书企业自建应用；未启用时保持留空
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_REDIRECT_URI=
FEISHU_PUBLIC_BASE_URL=

# 对外公开 URL（本地开发可留空；线上填 https://域名）
PUBLIC_BASE_URL=
APP_PUBLIC_URL=

# 跨域与反向代理；CORS_ORIGINS 多个值用英文逗号分隔
CORS_ORIGINS=
TRUST_PROXY=loopback

# 登录和注册限流
LOGIN_ACCOUNT_MAX_FAILURES=8
LOGIN_IP_MAX_FAILURES=40
REGISTER_IP_MAX_ATTEMPTS=5

# AI 租户级速率、突发容量与全局并发上限
AI_TENANT_RATE_PER_MINUTE=20
AI_TENANT_BURST=20
AI_MAX_CONCURRENT=8
AI_INTERACTIVE_EMBED_TIMEOUT_MS=3000
AI_INTERACTIVE_CHAT_TIMEOUT_MS=20000
RAG_MIN_SIMILARITY=0.25

# 可选运维路径
PDF_FONT_PATH=
MIGRATE_SNAPSHOT_DIR=
