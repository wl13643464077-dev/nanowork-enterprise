# 纳米Work行业版 · 本地安全默认模板（复制为 server/.env）

# 运行边界：新项目默认只监听本机 3107，不占用其他项目端口
NODE_ENV=development
HOST=127.0.0.1
PORT=3107

# 可选：指定本项目独立数据库；留空时使用 server/data/nanowork-industry.db
NANOWORK_DB=
# 仅本地演示才可改为 true；生产环境强制禁用
SEED_DEMO=false
# 自动任务安全默认关闭；仅确认当前实例允许执行定时任务后显式改为 true
ENABLE_SCHEDULER=false
# 开启后自动内容任务的全局最大在途数，默认 2（硬上限 16）
SCHEDULER_MAX_CONCURRENT=2

# 登录态签名密钥：生产必填，至少 32 字节的强随机串
# 生成示例：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# 平台超级管理员；仅首次初始化无 platform_super 账号时使用
# 生产首次启动密码至少 12 位，且大小写字母、数字、特殊字符至少包含三类
PLATFORM_SUPER_USERNAME=super
PLATFORM_SUPER_PASSWORD=

# AI 通道（OpenAI 兼容；变量名保持 YUNWU_*，调用链零改动）
# 密钥仅从服务端环境变量读取，不在管理后台或数据库保存新明文。
# OpenLux：YUNWU_BASE_URL=https://api.openlux.ai/v1 ，文档 https://doc.openlux.ai/
# 云雾：  YUNWU_BASE_URL=https://yunwu.ai/v1
YUNWU_API_KEY=
YUNWU_BASE_URL=https://api.openlux.ai/v1
ANTHROPIC_API_KEY=
AI_MODEL=

# 数字人真实引擎（显式选择缺配置时直接失败；auto 只在已配置引擎间回退）
RUNNINGHUB_API_KEY=
RUNNINGHUB_WORKFLOW_ID=
RUNNINGHUB_INSTANCE_TYPE=
HEYGEN_API_KEY=
# 可灵需让供应商读取人物图与口播音频；必须是公网 HTTPS 根地址，不得填内网地址
AVATAR_PROVIDER_PUBLIC_BASE_URL=

# 联网检索（老板参谋「联网」开关）：按顺序尝试 博查 → Tavily → Serper，
# 全部留空时兜底 DuckDuckGo（国内网络通常不可达，正式部署至少配一个）
BOCHA_API_KEY=
TAVILY_API_KEY=
SERPER_API_KEY=

# 飞书企业自建应用；未启用时保持留空
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_REDIRECT_URI=
FEISHU_PUBLIC_BASE_URL=

# 对外公开 URL（本地开发可留空；线上填 https://域名）
PUBLIC_BASE_URL=
APP_PUBLIC_URL=

# 跨域与反向代理；CORS_ORIGINS 多个值用英文逗号分隔
CORS_ORIGINS=
TRUST_PROXY=loopback

# 登录和注册限流
LOGIN_ACCOUNT_MAX_FAILURES=8
LOGIN_IP_MAX_FAILURES=40
REGISTER_IP_MAX_ATTEMPTS=5

# AI 租户级速率、突发容量与全局并发上限
AI_TENANT_RATE_PER_MINUTE=20
AI_TENANT_BURST=20
AI_MAX_CONCURRENT=8
AI_INTERACTIVE_EMBED_TIMEOUT_MS=3000
AI_INTERACTIVE_CHAT_TIMEOUT_MS=20000
RAG_MIN_SIMILARITY=0.25
# 后台知识库向量化默认关闭，避免导入资料时产生未确认的外部调用与费用
ENABLE_BACKGROUND_EMBEDDINGS=false
# 显式开启后，限制后台向量化并发（默认 2，避免批量导入压垮供应商）
BACKGROUND_EMBED_MAX_CONCURRENT=2
# 全局最多等待 100 个向量任务；队列满时新任务会明确返回 global_queue_full
BACKGROUND_EMBED_MAX_QUEUED=100
# 单租户最多等待 20 个任务，避免一个租户占满全局队列
BACKGROUND_EMBED_MAX_TENANT_PENDING=20
# 单租户最多同时执行 1 个任务，默认给其他租户保留并发槽
BACKGROUND_EMBED_MAX_TENANT_ACTIVE=1
# 排队等待共享 AI 租约最多 120 秒，超时后任务退出并释放预授权
BACKGROUND_EMBED_QUEUE_WAIT_TIMEOUT_MS=120000
# 单篇文档最多 8 次供应商调用（整文 1 次 + 最多 7 个分块，硬上限 16）
BACKGROUND_EMBED_MAX_CALLS_PER_DOC=8
# 每个成功持久化的向量按 1 积分结算；入队前按计划调用数全额预授权
BACKGROUND_EMBED_CREDITS_PER_CALL=1
# 单篇后台向量任务最长 60 秒，超时终止后按已成功持久化数量结算
BACKGROUND_EMBED_JOB_TIMEOUT_MS=60000
# 重启时恢复超过 15 分钟的陈旧向量占扣（无产物全退、有产物按实际结算）
BACKGROUND_EMBED_STALE_MINUTES=15

# ===== 在线支付通道（配置即用；全部留空时充值中心保持对公转账 + 平台人工确认流程）=====
# 安全提示：以下私钥/密钥均为高敏感凭据——只放在 .env（勿提交仓库），私钥 PEM 支持 \n 转义为单行；
# 服务端日志不会打印任何密钥内容；回调验签失败一律拒绝入账。

# --- 微信支付 Native（APIv3，扫码支付）：6 项齐全才启用该通道 ---
# 商户号
WXPAY_MCHID=
# 商户 API 证书序列号（商户平台 → API 安全）
WXPAY_SERIAL_NO=
# 商户 API 私钥 PEM（apiclient_key.pem 内容；可用 \n 转义为单行）
WXPAY_PRIVATE_KEY=
# APIv3 密钥（32 字节，用于回调报文 AES-256-GCM 解密）
WXPAY_APIV3_KEY=
# 与商户号绑定的公众号/小程序/APP 的 appid
WXPAY_APPID=
# 支付结果回调地址：https://你的域名/api/recharge/notify/wechat（必须公网可达 HTTPS）
WXPAY_NOTIFY_URL=
# 推荐：微信平台证书序列号到证书/公钥 PEM 的 JSON 映射，按 Wechatpay-Serial 精确验签；
# 证书内容换行写为 \\n。配置后优先于 WXPAY_PLATFORM_CERT，轮换期可同时保留新旧证书
# 结构示例：{"SERIAL_CURRENT":"-----BEGIN PUBLIC KEY-----\\n...\\n-----END PUBLIC KEY-----"}
WXPAY_PLATFORM_CERTS=
# 兼容旧部署的单份微信平台证书或平台公钥 PEM；未配置任一证书项时安全拒绝微信应答和回调
WXPAY_PLATFORM_CERT=

# --- 支付宝当面付（alipay.trade.precreate 预下单，扫码支付）：前 4 项齐全才启用 ---
# 开放平台应用 APPID
ALIPAY_APPID=
# 应用私钥 PEM（RSA2/2048；可用 \n 转义为单行）
ALIPAY_PRIVATE_KEY=
# 支付宝公钥 PEM（注意是“支付宝公钥”而非应用公钥，用于异步通知验签）
ALIPAY_PUBLIC_KEY=
# 异步通知地址：https://你的域名/api/recharge/notify/alipay（必须公网可达 HTTPS）
ALIPAY_NOTIFY_URL=
# 网关地址，默认生产网关；沙箱联调可改 https://openapi-sandbox.dl.alipaydev.com/gateway.do
ALIPAY_GATEWAY=

# 可选运维路径
PDF_FONT_PATH=
MIGRATE_SNAPSHOT_DIR=
