# 纳米Work行业版 · 生产/公网演示环境变量模板
# 目标文件：/etc/nanowork/server.env（权限 0640 root:nanowork；由 systemd EnvironmentFile 注入）
# 派生自 server/.env.example（约 70 项）。每项标注：
#   [必填]   演示环境上线前必须填写，preflight 会拦
#   [建议]   演示期推荐值，可按需调整
#   [可选]   不填即关闭/回退，不影响基础演示
#   [禁止]   演示/生产环境绝对不能开
# 语法：KEY=value；值含空格或 # 请加双引号；不要留下示例值（JWT_SECRET 含 example/占位 会被拒绝启动）。
# 本文件里不得出现任何真实密钥；真实值只存在于服务器上的 /etc/nanowork/server.env。

# ===== 运行边界 =====
# [必填] production 会强制：JWT_SECRET 强度校验、SEED_DEMO 禁用、超管密码强度、CORS 不再放行 localhost
NODE_ENV=production
# [必填] 只监听回环；公网入口是 Caddy（见 Caddyfile.example）
HOST=127.0.0.1
PORT=3107

# [必填] 数据库放到运行数据目录（代码目录只读）。注意 uploads 目录不可配置：
#        server/src/app.js 与各 engine 写死 server/data/uploads，deploy.sh 会把
#        /opt/nanowork/releases/<ts>/server/data 做成指向 /var/lib/nanowork/data 的符号链接。
NANOWORK_DB=/var/lib/nanowork/data/nanowork-industry.db
# [建议] scripts/migrate.mjs 迁移前快照目录（默认写到代码目录 backups/，在只读文件系统下会失败）
MIGRATE_SNAPSHOT_DIR=/var/backups/nanowork/migrate
# [可选] 任务产物目录（routes/files.js、engines/task-center.js 读取）；默认 server/data/uploads/artifacts，
#        走符号链接已落在 /var/lib/nanowork/data 下，通常不必单独设置。若设置必须仍在 /var/lib/nanowork 内（systemd 只放开该目录可写）
NANOWORK_ARTIFACT_DIR=
# [可选] 样片库文件 / 海报叠字底图与成品的落盘根目录；默认分别为 server/data/uploads/samples 与
#        server/data/uploads/poster-text（随符号链接落在 /var/lib/nanowork/data 下，受 uploadAccessGuard 保护）。
#        通常留空；若设置必须仍在 /var/lib/nanowork 内
NANOWORK_SAMPLE_UPLOAD_ROOT=
NANOWORK_POSTER_TEXT_UPLOAD_ROOT=

# [禁止] production 下设为 true 会直接抛错退出（演示种子含固定密码）。演示租户请用 scripts/provision-demo-tenants.mjs 正式创建
SEED_DEMO=false

# [建议] 演示期建议 true：让自动内容任务、定时规则可演示。前提：先跑一次 backup.sh，且已配置真实 AI 通道；
#        排查故障或只想演示手动流程时改回 false 并 systemctl restart nanowork
ENABLE_SCHEDULER=true
# [建议] 演示机 2~4 vCPU 保持 2；硬上限 16
SCHEDULER_MAX_CONCURRENT=2

# ===== 时区 =====
# TZ 由 systemd 单元 Environment=TZ=Asia/Shanghai 固定注入；这里不要再写 TZ，避免两处不一致。

# ===== 媒体与文档工具 =====
# [可选] install-ubuntu.sh 安装到 /usr/bin，留空即从 PATH 探测
FFMPEG_PATH=/usr/bin/ffmpeg
FFPROBE_PATH=/usr/bin/ffprobe
# [必填·文档导出] 必须是单文件 TTF/OTF（不支持 TTC/WOFF）；install-ubuntu.sh 会下载到此路径
PDF_FONT_PATH=/usr/local/share/fonts/NotoSansCJK-Regular.otf
# [建议] DOCX 渲染器优先读 DOCX_FONT_PATH，其次回退 PDF_FONT_PATH（server/src/engines/docx-report-renderer.js）
DOCX_FONT_PATH=/usr/local/share/fonts/NotoSansCJK-Regular.otf

# ===== 登录态与超管 =====
# [必填] ≥32 字节强随机；生成：openssl rand -base64 48
#        一旦上线就固定不变，换值会让所有已登录会话失效
JWT_SECRET=
# [必填·首次启动] 仅在库中没有 platform_super 时使用；≥12 位且含大写/小写/数字/符号中至少三类，不能含 example/password/secret 等占位词
PLATFORM_SUPER_USERNAME=super
PLATFORM_SUPER_PASSWORD=

# ===== AI 通道（OpenAI 兼容，变量名保持 YUNWU_*）=====
# [必填·演示核心] 没有它所有数字员工走"本地模板底稿"，无法演示真实生成。
#        11-release.md 前置清单第 1 条：必须先在服务商后台轮换已暴露的旧密钥，再把新密钥填这里。
YUNWU_API_KEY=
# [必填] OpenLux：https://api.openlux.ai/v1 ；云雾：https://yunwu.ai/v1
YUNWU_BASE_URL=https://api.openlux.ai/v1
# [可选] 备用直连 Anthropic；有 YUNWU_API_KEY 时不会用到
ANTHROPIC_API_KEY=
AI_MODEL=

# [可选] MiniMax H3 视频直连：演示期若无人核验计价，保持 0（关闭），走云雾视频通道即可
MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimax.io
NANOWORK_MINIMAX_H3_ENABLED=0

# [可选] 数字人引擎；未配置时数字人功能明确报"未配置"，不影响其他演示
RUNNINGHUB_API_KEY=
RUNNINGHUB_WORKFLOW_ID=
RUNNINGHUB_INSTANCE_TYPE=
HEYGEN_API_KEY=
# [可选] 可灵需要公网 HTTPS 根地址；若启用填 https://<域名>
AVATAR_PROVIDER_PUBLIC_BASE_URL=

# ===== 联网检索 =====
# [建议] TinyFish 为首选；无则回退 Claude WebSearch（需要服务端 Claude CLI，演示机通常没有）
TINYFISH_API_KEY=
BOCHA_API_KEY=
TAVILY_API_KEY=
SERPER_API_KEY=
# [可选] Claude WebSearch 回退链路与内容连接器联网检索（趋势官/情报员/复盘师）所用模型；留空默认 claude-opus-4-8
NANOWORK_RESEARCH_MODEL=

# ===== 高德地图 Web 服务（选址/商圈岗位 101/102/104）=====
# [建议] 招商会要演示选址岗位时配置：https://console.amap.com/ → 应用管理 → 创建应用 → 添加 Key，
#        服务平台务必选「Web服务」（选成 Web端/JS API 会返回 10009）。密钥只从 env 读取，不进库、不回显前端。
#        未配置 → 就绪矩阵第 9 通道显示"未配置"，选址岗位回落 OSM 与公开检索并在报告中如实标注（不阻塞演示）。
#        配置后 systemctl restart nanowork，再到 管理后台 → 接口管理 → "高德地图 Web 服务" 点击"测试连接"。
#        日配额以高德控制台为准；用尽返回 10003，通道自动转 blocked 并回落 OSM，次日恢复后重新测试。
AMAP_WEB_KEY=
# [可选] 默认 https://restapi.amap.com；只接受 https，非 https 会被忽略回默认
AMAP_BASE_URL=
# [可选] 触发"商圈结构化事实"（高德优先→OSM 回落）的餐饮岗位序号，逗号分隔；默认 101,102,104，一般不改
NANOWORK_TRADE_AREA_EMPLOYEE_IDX=

# ===== 飞书 =====
# [可选] 演示不演示飞书推送可全部留空；一旦填 App ID/Secret，回调地址必须 https
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_REDIRECT_URI=
FEISHU_PUBLIC_BASE_URL=

# ===== 对外地址、CORS、反向代理 =====
# [必填] 与 Caddyfile 域名一致；生产下 system.js 要求有公开地址才生成回调 URL
PUBLIC_BASE_URL=https://demo.example.com
APP_PUBLIC_URL=https://demo.example.com
# [必填] production 下不再放行 localhost；Electron 桌面端连同一 origin，无需额外加。多个用英文逗号分隔
CORS_ORIGINS=https://demo.example.com
# [必填] Caddy 在本机，只信任一跳；否则 req.secure=false → Cookie 不带 Secure、限流按代理 IP 计
TRUST_PROXY=1

# ===== 登录/注册限流 =====
# [建议] 招商会现场多人共用会场 Wi-Fi 出口 IP，适当放宽 IP 维度；账号维度保持 8
LOGIN_ACCOUNT_MAX_FAILURES=8
LOGIN_IP_MAX_FAILURES=100
# [注意] 注册按 IP 每小时计数（含成功）。provision-demo-tenants.mjs 一次建 6 家企业会触发默认 5 的限制：
#        建租户前临时改为 20 并重启，建完改回 5 再重启（脚本遇 429 会提示）
REGISTER_IP_MAX_ATTEMPTS=5

# ===== AI 速率与并发 =====
# [建议] 6 家演示企业同时演示：租户级 20/分钟够用；全局并发 8 与 2~4 vCPU 匹配
AI_TENANT_RATE_PER_MINUTE=20
AI_TENANT_BURST=20
AI_MAX_CONCURRENT=8
AI_INTERACTIVE_EMBED_TIMEOUT_MS=3000
AI_INTERACTIVE_CHAT_TIMEOUT_MS=20000
RAG_MIN_SIMILARITY=0.25
# [可选] 数据导入「拍照/截图识别报表」单张识别超时（毫秒）；留空默认 90000，范围 500~300000
DATA_INTAKE_VISION_TIMEOUT_MS=
# [建议] 演示期关闭后台向量化，避免导入知识库时产生未确认的费用；需要演示知识库检索时再开
ENABLE_BACKGROUND_EMBEDDINGS=false
BACKGROUND_EMBED_MAX_CONCURRENT=2
BACKGROUND_EMBED_MAX_QUEUED=100
BACKGROUND_EMBED_MAX_TENANT_PENDING=20
BACKGROUND_EMBED_MAX_TENANT_ACTIVE=1
BACKGROUND_EMBED_QUEUE_WAIT_TIMEOUT_MS=120000
BACKGROUND_EMBED_MAX_CALLS_PER_DOC=8
BACKGROUND_EMBED_CREDITS_PER_CALL=1
BACKGROUND_EMBED_JOB_TIMEOUT_MS=60000
BACKGROUND_EMBED_STALE_MINUTES=15

# ===== 在线支付 =====
# [禁止·演示期] 全部留空 → 充值中心走"对公转账 + 平台人工确认"，演示"充值页"足够；
#               任何一项填了真实商户私钥都意味着真实入账链路，需要 11-release.md 前置清单第 3 条的沙箱验收
WXPAY_MCHID=
WXPAY_SERIAL_NO=
WXPAY_PRIVATE_KEY=
WXPAY_APIV3_KEY=
WXPAY_APPID=
WXPAY_NOTIFY_URL=
WXPAY_PLATFORM_CERTS=
WXPAY_PLATFORM_CERT=
ALIPAY_APPID=
ALIPAY_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=
ALIPAY_NOTIFY_URL=
ALIPAY_GATEWAY=
